{
  "incremental": true,
  "lineWidth": 80,
  "indentWidth": 2,
  "typescript": {
    "locked": true,
    "spaceSurroundingProperties": false,
    "importDeclaration.spaceSurroundingNamedImports": false,
    "typeLiteral.spaceSurroundingProperties": false,
    "exportDeclaration.spaceSurroundingNamedExports": false,
    "quoteStyle": "preferSingle",
    "module.sortImportDeclarations": "maintain"
  },
  "json": {
    "locked": true
  },
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "**/dist",
    "storybook-static",
    "docs"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.96.1.wasm",
    "https://plugins.dprint.dev/json-0.25.0.wasm",
    "https://plugins.dprint.dev/markdown-0.24.0.wasm"
  ]
}
