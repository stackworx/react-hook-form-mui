{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc -b tsconfig.json packages/mui packages/x-date-pickers packages/x-date-pickers-pro",
    "test": "vitest run",
    "lint": "eslint --max-warnings=0 .",
    "fmt": "dprint fmt",
    "check": "dprint check && npm run lint && npm run typecheck && npm run test && npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release:version": "lerna version",
    "release:publish": "bash scripts/publish-new-versions.sh"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@eslint-react/eslint-plugin": "5.21.1",
    "@eslint/js": "10.0.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/x-date-pickers": "9.14.0",
    "@mui/x-date-pickers-pro": "9.14.0",
    "@mui/x-license": "9.13.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/luxon": "3.7.5",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "dprint": "0.57.4",
    "eslint": "10.11.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "jsdom": "30.1.1",
    "lerna": "10.0.1",
    "luxon": "3.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "storybook": "10.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vite-plugin-dts": "5.1.1",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
